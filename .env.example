# Application
NODE_ENV=development
PORT=3000
APP_NAME=Loki-Dhaka
APP_VERSION=1.0.0
LOG_LEVEL=debug

# Database
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loki_dhaka
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@loki-dhaka.com
EMAIL_FROM_NAME=Loki Dhaka

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# API Configuration
API_BASE_URL=http://localhost:3000/api
API_RATE_LIMIT=100
API_RATE_WINDOW=15m

# External Services
SENDGRID_API_KEY=your_sendgrid_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Third-party Integrations
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_secret
MICROSOFT_OAUTH_CLIENT_ID=your_microsoft_client_id
MICROSOFT_OAUTH_CLIENT_SECRET=your_microsoft_secret

# Monitoring & Analytics
SENTRY_DSN=https://your_sentry_key@sentry.io/project_id
NEW_RELIC_LICENSE_KEY=your_new_relic_key
DATA_DOG_API_KEY=your_datadog_key

# Features & Feature Flags
FEATURE_ADVANCED_REPORTING=true
FEATURE_AI_INSIGHTS=false
FEATURE_BULK_OPERATIONS=true
FEATURE_WEBHOOKS=true

# Caching
REDIS_URL=redis://localhost:6379
REDIS_DB=0
CACHE_TTL=3600

# Timezone & Locale
DEFAULT_TIMEZONE=UTC
DEFAULT_LOCALE=en-US

# Development
DEBUG=loki-dhaka:*
QUEST_ENABLE_COLORS=true
